# Docker/local database settings
MYSQL_ROOT_PASSWORD=replace-with-a-strong-password
MYSQL_DATABASE=youai_crm
MYSQL_HOST_PORT=3308
MYSQL_CPUS=1.0
MYSQL_MEMORY_LIMIT=1536m
MYSQL_MEMORY_SWAP_LIMIT=1536m
BACKEND_CPUS=1.0
BACKEND_MEMORY_LIMIT=1024m
BACKEND_MEMORY_SWAP_LIMIT=1024m
FRONTEND_CPUS=0.25
FRONTEND_MEMORY_LIMIT=256m
FRONTEND_MEMORY_SWAP_LIMIT=256m
BACKEND_HOST_PORT=8080
FRONTEND_HOST_PORT=4173
DB_URL=jdbc:mysql://127.0.0.1:3306/youai_crm?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai&useSSL=true
DB_USERNAME=youke_app
DB_PASSWORD=replace-with-a-strong-application-password
INITIAL_ADMIN_PASSWORD=replace-with-a-strong-initial-admin-password

# Required when running with the Spring "prod" profile
SPRING_PROFILES_ACTIVE=prod
# Required only for the first start with an empty account table. Remove after initialization.
BOOTSTRAP_ADMIN_USERNAME=
BOOTSTRAP_ADMIN_PASSWORD=
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_ACCESS_TTL_HOURS=2
JWT_REFRESH_TTL_DAYS=7
LOGIN_IP_MAX_ATTEMPTS=30
LOGIN_IP_WINDOW_SECONDS=60
LOGIN_ACCOUNT_MAX_FAILURES=5
LOGIN_ACCOUNT_LOCK_SECONDS=900

# Optional recording AI. Leave empty to keep external analysis disabled.
# Configure only after selecting the provider and authorizing audio processing.
RECORDING_AI_API_KEY=
RECORDING_AI_TRANSCRIPTION_MODEL=
RECORDING_AI_SUMMARY_MODEL=

# Qwen transcription only. Server configuration; never expose in frontend.
QWEN_ASR_API_KEY=
QWEN_ASR_MODEL=qwen3-asr-flash
QWEN_ASR_ENDPOINT=https://dashscope.aliyuncs.com/compatible-mode/v1/chat/completions

# Local ASR takes precedence; errors never fall back to cloud.
LOCAL_ASR_ENABLED=false
LOCAL_ASR_ENDPOINT=http://host.docker.internal:8766/transcribe
# Recording files: file (persistent directory) or s3 (private S3-compatible bucket).
RECORDING_STORAGE_BACKEND=file
RECORDING_HOST_DIRECTORY=./data/recordings
RECORDING_S3_BUCKET=
RECORDING_S3_ENDPOINT=
RECORDING_S3_REGION=us-east-1
RECORDING_S3_ACCESS_KEY=
RECORDING_S3_SECRET_KEY=
RECORDING_S3_PATH_STYLE=false
RECORDING_QUEUE_CONCURRENCY=1
DEEPSEEK_API_KEY=
# RAG-Notebook internal retrieval adapter (use a randomly generated long token).
RAG_NOTEBOOK_ENABLED=true
RAG_INTERNAL_TOKEN=
# Empty embedding key uses the configured Qwen key in compose.
RAG_EMBEDDING_API_KEY=
RAG_EMBEDDING_MODEL=text-embedding-v4
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_ENDPOINT=https://api.deepseek.com/chat/completions
